{
  "name": "adwebcrm-mcp",
  "version": "0.1.1",
  "mcpName": "io.github.DannyCasan/adwebcrm-mcp",
  "description": "Model Context Protocol (MCP) server for adwebcrm — drive your self-hosted multichannel CRM from Claude, Cursor, and other MCP clients.",
  "license": "MIT",
  "author": "DannyCasan",
  "homepage": "https://github.com/Dacasan/adwebcrm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dacasan/adwebcrm.git",
    "directory": "mcp-server"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "adwebcrm",
    "whatsapp",
    "crm",
    "claude",
    "ai"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "bin": {
    "adwebcrm-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.7.0"
  }
}
